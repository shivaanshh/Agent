# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REVIEW_MODEL=openai/gpt-oss-20b   # step reviewer; its own per-minute limit spreads the load ("" = main model)
# LLM_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible endpoint works
# TOKEN_BUDGET=60000        # soft cap on tokens per run
# LLM_TPM_LIMIT=8000        # your tier's tokens-per-minute limit; the agent paces itself under it (0 = off)
# REASONING_EFFORT=low      # sent to reasoning models (qwen3, gpt-oss); empty to omit
# LLM_TIMEOUT=60
# TOOL_TIMEOUT=20
# TOOL_RETRIES=2
# MAX_PLAN_STEPS=6
# MAX_ACTIONS_PER_STEP=4
# AGENT_CONTACT=https://github.com/<you>/<repo>   # sent in the User-Agent (Wikipedia requires a contact)

# Optional second free provider for the main model (free key: https://cloud.cerebras.ai).
# Each main-model call goes to whichever of Groq and Cerebras can take it sooner; any Cerebras
# error hands the call back to Groq. Leave the key empty to use Groq only.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b      # must be the same model as GROQ_MODEL, otherwise it stays off
# CEREBRAS_TPM_LIMIT=30000         # free tier: 30K tokens and
# CEREBRAS_RPM_LIMIT=5             # 5 requests a minute

# ── legacy/app.py (the MyAgent chat UI) ──────────────────────────────────────
# It reads the same GROQ_API_KEY above. Provider is chosen at startup:
#   auto (default) = Groq if GROQ_API_KEY is set, else OpenAI
# LLM_PROVIDER=auto
# OPENAI_API_KEY=            # only needed if LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o
#
# Requests that are a single local function call (run code, convert units,
# arithmetic, dates, word count, list tasks/notes/files) are answered without
# calling any model. Set to 0 to route everything through the LLM instead.
# FAST_PATH=1
#
# 127.0.0.1 by default. /chat can reach run_code, so 0.0.0.0 puts arbitrary
# code execution on whatever network you are joined to.
# HOST=127.0.0.1
# PORT=5000
#
# Email tools (optional; Gmail needs an app password, not your login password)
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
